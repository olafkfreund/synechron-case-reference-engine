# Demo model settings (no secrets). scripts/demo.sh blanks these when Ollama is not running.
EXTRACT_MODEL=ollama_chat/qwen3:14b
DRAFT_MODEL=ollama_chat/qwen3:14b
EXTRACT_MODEL_OPTIONS='{"think": false, "num_ctx": 24576, "repeat_penalty": 1.05, "api_base": "http://host.docker.internal:11434", "destination": "local"}'
DRAFT_MODEL_OPTIONS='{"think": false, "num_ctx": 24576, "repeat_penalty": 1.05, "api_base": "http://host.docker.internal:11434", "destination": "local"}'
