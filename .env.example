# MCP server (#249). On unless MCP_ENABLED=0; when on, /mcp is mounted and the app will not start without
# MCP_ISSUER, MCP_AUDIENCE and MCP_CLIENT_IDS.
# MCP_ENABLED=0
# Entra v2 issuer, e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 (required)
# MCP_ISSUER=
# The API app's audience, i.e. the `aud` of its access tokens (required)
# MCP_AUDIENCE=
# Comma-separated app ids (the token's azp) of the AI clients you approve; required. Anything else gets 403
# MCP_CLIENT_IDS=
# Refuse tokens from any other tenant
# MCP_TENANT_ID=
# Delegated scope a token must carry (default refs.access)
# MCP_SCOPE=refs.access
# Default: the issuer's /discovery/v2.0/keys
# MCP_JWKS_URL=
# Default: $APP_ORIGIN/mcp
# MCP_RESOURCE_URL=

# Local dev (docker compose up idp web): the compose file already sets these for the mock IdP.
#   docker compose up web
#   MCP_ISSUER=http://idp.localhost:8080/refs-mcp   MCP_AUDIENCE=refs-mcp   MCP_SCOPE=refs.access
#   scripts/mcp_token.sh alice refs-users           # a dev token, printed to stdout
